# Supabase / Postgres
# DATABASE_URL is OPTIONAL. Leave blank and `npm run backup` will ask for the
# database password each run, storing nothing. Fill it in only if you prefer
# the password saved locally (this file is gitignored; .env is too).
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Providers (§5)
FOOTBALL_DATA_ORG_TOKEN=
API_FOOTBALL_KEY=
# WhatsApp Cloud API (§7.2) — human must complete: Meta Business account +
# verification, WABA, dedicated phone number, System User token, HTTPS webhook
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Telegram (§7.1, ship active first)
TELEGRAM_BOT_TOKEN=
# Must equal the secret_token passed to setWebhook; arrives as X-Telegram-Bot-Api-Secret-Token.
# Unset = webhook rejects every update.
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=https://fantasy-money-game.vercel.app
# Cron (GitHub Actions → /api/cron/poll)
CRON_SECRET=
# Commissioner credential for the money-writing routes (/api/manual-entry,
# /api/approvals/[id], /api/amendments/ratify, /api/corrections, /api/backfill).
# Send as `Authorization: Bearer <ADMIN_SECRET>`. Unset = every write route locked (401).
ADMIN_SECRET=
# Feature flags (§2, §17)
POLLER_ENABLED=false
WHATSAPP_ENABLED=false
